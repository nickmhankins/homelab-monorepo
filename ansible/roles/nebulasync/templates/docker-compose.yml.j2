---
services:
  nebula-sync:
    container_name: nebula-sync
    image: ghcr.io/lovelaze/nebula-sync:v0.11.1
    environment:
      PRIMARY: "https://pihole1.mandatorygoat.com|{{ password }}"
      REPLICAS: "https://pihole2.mandatorygoat.com|{{ password }}"
      FULL_SYNC: true
      RUN_GRAVITY: true
      CRON: "*/15 * * * *"
    restart: unless-stopped
